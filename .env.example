# Copy to .env and fill in. .env is never committed.

# --- Server ---
PORT=3000
# Bind to 127.0.0.1 if you put a reverse proxy in front; 0.0.0.0 to reach it on your LAN.
HOST=0.0.0.0

# --- LLM (any OpenAI-compatible endpoint: school GLM, vLLM, Ollama, llama.cpp, mock) ---
LLM_BASE_URL=http://localhost:4000/v1
LLM_API_KEY=changeme
LLM_MODEL=glm-5.3
# Max parallel LLM requests. Keep this modest on a shared server.
LLM_MAX_CONCURRENT=8
LLM_TIMEOUT_MS=120000
# Extra JSON merged into every request body, e.g. to switch thinking on for GLM via vLLM:
# LLM_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":true}}
LLM_EXTRA_BODY=

# --- World clock ---
# How many real minutes one game day lasts at speed 1x.
DAY_LENGTH_REAL_MINUTES=45

# --- Conversation pacing (real seconds, so you can read along) ---
# The next line in a conversation waits until the previous one could be read. 0 disables it.
SPEECH_CHARS_PER_SECOND=15
SPEECH_MIN_SECONDS=2

# --- Quiet-time speed-up: while everyone sleeps or is busy, the clock speeds up by itself ---
QUIET_SPEEDUP=true
QUIET_MAX_SPEED=20

# --- Scenario used when seeding an empty world (content/scenarios/<id>): village | newcomers ---
SCENARIO=village

# --- Step 4: model profiles (optional; without LLM_PROFILES the LLM_* block above is the "school" profile) ---
# LLM_PROFILES=school,local
# LLM_SCHOOL_BASE_URL=https://...
# LLM_SCHOOL_API_KEY=...
# LLM_SCHOOL_MODEL=zai-org/GLM-5.3-Flash
# LLM_SCHOOL_MAX_CONCURRENT=8
# Thinking per tier (merged into the request). Measured on the school GLM: reasoning_effort "low" really turns
# thinking off; enable_thinking:false only moves the reasoning into the answer. A 600-token "light" call with
# thinking on runs out of tokens, so light defaults to the OFF setting.
# LLM_SCHOOL_THINKING_ON={}
# LLM_SCHOOL_THINKING_LIGHT={"reasoning_effort":"low"}
# LLM_SCHOOL_THINKING_OFF={"reasoning_effort":"low"}
# LLM_LOCAL_BASE_URL=http://localhost:11434/v1
# LLM_LOCAL_API_KEY=ollama
# LLM_LOCAL_MODEL=<your local model>
# LLM_LOCAL_MAX_CONCURRENT=2
# LLM_LOCAL_THINKING_OFF={}
# Purpose → profile chain (first available wins). Defaults shown:
# LLM_ROUTES={"decide":["school"],"plan":["school"],"reflect":["school"],"consolidate":["school"],"bootstrap":["school"],"observer":["local","school"],"director_text":["local","school"],"score":["local"],"test":["school"],"keeper":["local","school"]}
# LLM_TIMEOUTS={"observer":300000,"consolidate":240000,"keeper":60000}
# Step 5.5: check every decision prompt for leaked secret goals / secret group memberships (logs an error event).
# DEBUG_LEAK_CHECK=true

# Step 6: emotions
# Feelings spread between people in a room (fear, anger, joy, sadness, disgust). The director can toggle it live.
# EMOTION_CONTAGION=true
# Experiments only: overwhelming anger/fear (>= 8) lowers the thinking tier one step and raises the temperature.
# EMOTION_PARAM_EFFECTS=false
# Base temperature used when EMOTION_PARAM_EFFECTS raises it.
# EMOTION_PARAM_BASE_TEMPERATURE=0.7

# Step 5: the room keeper (purpose "keeper") turns free-form "use" / targeted "do" / hiding into object changes.
# It prefers "local" and falls back to "school"; with neither (or the governor in red) code keyword rules decide.

# --- Step 4: token budget governor (output tokens per rolling real hour; 0 = off) ---
TOKEN_BUDGET_OUTPUT_PER_HOUR=500000
GOVERNOR_PROFILES=school

# --- Step 4: observer batching ---
OBSERVER_MIN_INTERVAL_REAL_SECONDS=180
OBSERVER_CONVERSATIONS_PER_CITIZENS=10
